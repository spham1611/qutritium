# CITATION File Format -- https://citation-file-format.github.io/
# This file lets GitHub render a "Cite this repository" sidebar widget and
# provides machine-readable citation metadata for tools like Zenodo, Zotero,
# CFF-tools, etc.

cff-version: 1.2.0
message: "If you use Qutritium in your research, please cite it as below."
type: software
title: "Qutritium: a hardware-agnostic Python library for qutrit quantum computing"
abstract: >-
  Qutritium provides a Python implementation of qutrit (3-level) quantum
  gate definitions, circuit construction, an exact statevector simulator,
  and SU(3) decomposition into native subspace rotations. From v1.0.0
  onward the package is hardware-agnostic (numpy/scipy only); earlier
  0.0.x releases shipped Qiskit-pulse-based calibration routines for IBM
  quantum hardware and are preserved as a historical record under the
  legacy/ directory.

authors:
  - family-names: Pham
    given-names: Son
    affiliation: "Duke University"
  - family-names: Nguyen
    given-names: Tien
    affiliation: "École Polytechnique, France"
  - family-names: Bach
    given-names: Bao
    affiliation: "University of Delaware, USA"
  - family-names: He
    given-names: Charlie
    affiliation: "Duke University, USA"

repository-code: "https://github.com/spham1611/qutritium"
url: "https://github.com/spham1611/qutritium"
license: MIT
version: "1.2.1"
date-released: "2026-05-21"

keywords:
  - quantum computing
  - qutrit
  - qudit
  - SU(3)
  - quantum simulation
  - quantum gate decomposition

# References to related works -- the original Munich poster in particular.
references:
